# add local include paths
PKG_CPPFLAGS = -I./backend/include -I./backend/build/local_install/include -I./backend/lib/OpenCL-Wrapper/src  -DBUILDING_STATIC_R_PACKAGE \
               -DOPENCLEAR_R_BUILD \
               -DOPENCLEAR_NO_OUTPUT # supress stc::cout/cerr use 

# -mstackrealign fixes the R-MinGW stack issue
# -O2 instead of -O3 prevents overly aggressive loop optimizations that kill the CPU runtime
PKG_CXXFLAGS = -mstackrealign -O2

# STATIC LINKING: We link the static libBACKEND.a
# and force the linker to hard-embed the symbols into the main DLL.
# On Windows we use -l:BACKEND.a so that MinGW-ld finds the file directly.
PKG_LIBS = -Lbackend/build -l:BACKEND.a -Lbackend/build/local_install/lib -lOpenCL

SHLIB_LDFLAGS = $(SHLIB_CXXLDFLAGS) -g


# Under Windows we no longer have to copy BACKEND.dll into the libs folder,
# since it has physically disappeared in the main DLL as we are statically loinking BACKEND!
# Just include the OpenCL.dll:
all: $(SHLIB)
	@mkdir -p "$(R_PACKAGE_DIR)/libs"
	@FOUND_OPENCL=$$(find backend/build/ -name "OpenCL.dll" | head -n 1); \
	if [ -n "$$FOUND_OPENCL" ] && [ -f "$$FOUND_OPENCL" ]; then \
		mkdir -p $(R_PACKAGE_DIR)/libs$(R_ARCH)/; \
		cp "$$FOUND_OPENCL" $(R_PACKAGE_DIR)/libs$(R_ARCH)/; \
	fi
	@cp -f backend/BACKEND.a "$(R_PACKAGE_DIR)/libs/BACKEND.a" 2>/dev/null || cp -f BACKEND.a "$(R_PACKAGE_DIR)/libs/BACKEND.a" 2>/dev/null || true


# not yet used (exfiltrate kernel mathlib cl code from nmathopencl package)
prebuild:
	@echo "[OpenCLeaR Build] Generate nmath.cl via R-Skript...\n"
	@"$(R_HOME)/bin/Rscript" --vanilla ../tools/convert_nmath.R

.PHONY: all prebuild
