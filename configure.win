#!/bin/sh

# Compile the Backend library first:
echo "** COMPILING THE OPENCL BACKEND CODE NOW! **"

BUILD_DIR="src/backend/build"
INSTALL_DIR="src"

mkdir -p "$BUILD_DIR"
mkdir -p "$INSTALL_DIR"

cd "$BUILD_DIR" || {
	echo "Build dir was not made! Check if you have permissions..."
	exit 1
}	

cmake .. -DCMAKE_BUILD_TYPE=Release || {
	echo "CMake configuration failed..."
	exit 1
}

cmake --build . || {
	echo "Build failed..."
	exit 1
}

# Copy the binary in src/
DLL_NAME="BACKEND.a"
if [ -f "$DLL_NAME" ]; then
	cp "$DLL_NAME" "../../../$INSTALL_DIR/"
elif [ -f "Release/$DLL_NAME" ]; then
	cp "Release/$DLL_NAME" "../../../$INSTALL_DIR/"
else
	echo "Could not find built $DLL_NAME"
	exit 1
fi

echo "** SUCCESSFULLY BUILT OPENCL BACKEND CODE! **"


# Copy the kernel files (Resources)
cd "../../.."


#echo "** COPYING KERNELS! **"

#mkdir -p inst/kernel

#cp src/backend/kernel/*.cl inst/kernel/ 2>/dev/null

#echo "** SUCCESSFULLY COPIED KERNELS! **"

echo "** COPYING INCLUDES! **"

mkdir -p inst/include
## FIXME: ???
cp src/backend/kernel/*.cl inst/include/ 2>/dev/null

echo "** SUCCESSFULLY COPIED INCLUDES! **"


ADAPTER_H="src/backend/lib/OpenCL-ICD-Loader/loader/windows/adapter.h"

echo "🔧 [OpenCLeaR Windows-Build] Starte umfassende CRAN-Fehlerkorrektur für OpenCL-ICD-Loader..."

# 1. Lokaler Pragma-Schutzwall für adapter.h gegen -Wpedantic
if [ -f "$ADAPTER_H" ]; then
    echo "  -> Injiziere GCC-Pragmas in $ADAPTER_H"
    echo -e '#if defined(__GNUC__) || defined(__clang__)\n#pragma GCC diagnostic push\n#pragma GCC diagnostic ignored "-Wpedantic"\n#endif\n' > "$ADAPTER_H.tmp"
    cat "$ADAPTER_H" >> "$ADAPTER_H.tmp"
    echo -e '\n#if defined(__GNUC__) || defined(__clang__)\n#pragma GCC diagnostic pop\n#endif' >> "$ADAPTER_H.tmp"
    mv "$ADAPTER_H.tmp" "$ADAPTER_H"
fi

# 2. Rekursiver Kahlschlag gegen leere Prototypen () -> (void) im gesamten ICD-Baum
echo "  -> Bereinige leere C-Funktionsprototypen im gesamten Tree..."
find src/backend/lib/OpenCL-ICD-Loader/ -type f \( -name "*.c" -o -name "*.h" \) | while read -r cfile; do
    if grep -q "khrIcdOsVendorsEnv32Bit()" "$cfile" 2>/dev/null; then
        sed -i 's/khrIcdOsVendorsEnv32Bit()/khrIcdOsVendorsEnv32Bit(void)/g' "$cfile"
    fi
    if grep -q "khrIcdOsVendorsEnvRecurse()" "$cfile" 2>/dev/null; then
        sed -i 's/khrIcdOsVendorsEnvRecurse()/khrIcdOsVendorsEnvRecurse(void)/g' "$cfile"
    fi
done

echo "✅ [OpenCLeaR Windows-Build] Gesamter Quellcodetree erfolgreich für R-devel präpariert."

exit 0

