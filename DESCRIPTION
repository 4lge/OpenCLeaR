Package: OpenCLeaR
Type: Package
Title: An OpenCL Enhanced Accelerated R-Package
Version: 0.5.9
Author: Albrecht Gebhardt
Authors@R: person(given = "Albrecht",
                family = "Gebhardt",
                role = c("aut", "cre"),
                email = "albrecht.gebhardt@aau.at")
Authors@R: person(given = "Julian",
                family = "Märte",
