Package: OpenCLeaR
Type: Package
Title: Easy Access to OpenCL using C++, CMake and Rcpp
Version: 0.7.3
Authors@R: c(person("Albrecht", "Gebhardt", role = c("aut", "cre", "cph"),
                    email = "albrecht.gebhardt@aau.at"),
             person("Julian", "Märte", role = c("cph", "ctb"),
