# 1. Entfernt radikal alle verbleibenden .git-Verzeichnisse in den Submodulen
^src/backend/lib/.*/\.git(/|$)
^src/backend/.*\.git(/|$)
^src/backend/lib/CLErrorLookup/\.git(/|$)
^src/backend/lib/OpenCL-CLHPP/\.git(/|$)
^src/backend/lib/OpenCL-Headers/\.git(/|$)
^src/backend/lib/OpenCL-Wrapper\.git(/|$)


# 2. Ignoriert den kompletten CMake-Build-Ordner und lokale Installationen im Backend
^src/backend/build(/|$)
^src/backend/lib(/|$)

# 3. Ignoriert OpenCL-Laufzeit-Caches und Test-Artefakte überall im Paket
^inst/tinytest/\.cl_cache(/|$)
^\.cl_cache(/|$)

# 4. Ignoriert R-spezifische Check-Überbleibsel und Tarballs
^OpenCLeaR_.*\.tar\.gz$
^.*\.Rcheck(/|$)

# 5. Entwickler-Dateien ausschließen
^NAMESPACE\.in$
^TODO\.md$
^Makefile$
^inst/\.gitkeep$
^\.gitkeep$

#
^inst/bin/ocl_compiler.*$
