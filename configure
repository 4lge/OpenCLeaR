#!/bin/sh
set -e

# Compile the Backend library first:
echo "** COMPILING THE OPENCL BACKEND CODE NOW! **"

BUILD_DIR="src/backend/build"
INSTALL_DIR="src"

# Detect OS and set appropriate extension and rpath flags.
UNAME=$(uname)
if [ "${UNAME}" = "Darwin" ]; then
    # macOS settings
    SHLIB_EXT="dylib"
else
    # Linux settings
    SHLIB_EXT="so"
fi

mkdir -p "$BUILD_DIR"
mkdir -p "$INSTALL_DIR"

cd "$BUILD_DIR" || {
	echo "Build dir was not made! Check if you have permissions..."
	exit 1
}

cmake .. -DCMAKE_BUILD_TYPE=Release || {
	echo "CMake configuration failed..."
	exit 1
}

TARGET_HEADER="src/backend/lib/CLErrorLookup/CLErrorLookup/include/cl_error_lookup.hpp"
if [ -f "../../$TARGET_HEADER" ]; then
    if [ "$(tail -c1 "../../$TARGET_HEADER" | wc -l)" -eq 0 ]; then
        echo " [configure] Append missing newline to source header..."
        echo "" >> "../../$TARGET_HEADER"
    fi
fi

cmake --build . || {
	echo "Build failed..."
	exit 1
}


# Copy the binary in src/
DLL_NAME="libBACKEND."${SHLIB_EXT}
if [ -f "$DLL_NAME" ]; then
	cp "$DLL_NAME" ../../$DLL_NAME
elif [ -f "Release/$DLL_NAME" ]; then
	cp "Release/$DLL_NAME" ../../$DLL_NAME
else
	echo "Could not find built $DLL_NAME"
	exit 1
fi

echo "** SUCCESSFULLY BUILT OPENCL BACKEND CODE! **"

# Go back to the main directory of the package
cd ../../..

# We copy the built libraries NOW directly into the src folder,
# so that the R compiler immediately finds them locally when linking.
mkdir -p src/

if [ -f "libBACKEND.so" ]; then
    cp libBACKEND.so src/
fi
if [ -f "libBACKEND.dylib" ]; then
    cp libBACKEND.dylib src/
fi

# =========================================================================
#  Generate platform-specific src/Makevars 
# =========================================================================
UNAME=$(uname)

if [ "${UNAME}" = "Darwin" ]; then
    #  macOS version: Search path expanded to ../lib/ relative to libs/OpenCLeaR.so
    cat << 'EOF' > src/Makevars
PKG_CPPFLAGS = -I./backend/include -I./backend/build/local_install/include -DOPENCLEAR_NO_OUTPUT -DOPENCLEAR_R_BUILD
PKG_LIBS = -Wl,-rpath,@loader_path/../lib/ -Wl,-rpath,@loader_path/ -L. -lBACKEND

.PHONY: all prebuild

all: $(SHLIB)
	@echo " [OpenCLeaR] Copy binaries to the CRAN-compliant inst/lib directory (macOS)..."
	@mkdir -p $(R_PACKAGE_DIR)/lib/
	@if [ -f libBACKEND.dylib ]; then cp libBACKEND.dylib $(R_PACKAGE_DIR)/lib/; fi
	@if [ -f backend/build/local_install/lib/libOpenCL.dylib ]; then cp backend/build/local_install/lib/libOpenCL.dylib $(R_PACKAGE_DIR)/lib/; fi
	@echo " [OpenCLeaR] Remove libBACKEND.dylib from src/ to prevent duplicates in libs/..."
	@rm -f libBACKEND.so libBACKEND.dylib
EOF

else
    #  Linux version: Search path expanded to $ORIGIN/../lib
cat << 'EOF' > src/Makevars
PKG_CPPFLAGS = -I./backend/include -I./backend/build/local_install/include -DOPENCLEAR_NO_OUTPUT -DOPENCLEAR_R_BUILD 
PKG_LIBS = -Wl,-rpath,'$$ORIGIN/../lib:$$ORIGIN' -Wl,--enable-new-dtags -L. -lBACKEND

.PHONY: all prebuild

all: $(SHLIB)
	@echo " [OpenCLeaR] Copy binaries to the CRAN-compliant inst/lib directory..."
	@mkdir -p $(R_PACKAGE_DIR)/lib/
	@if [ -f libBACKEND.so ]; then cp libBACKEND.so $(R_PACKAGE_DIR)/lib/; fi
	@if [ -f backend/build/local_install/lib/libOpenCL.so ]; then cp backend/build/local_install/lib/libOpenCL.so $(R_PACKAGE_DIR)/lib/; fi
	@echo " [OpenCLeaR] Remove libBACKEND.so from src/ to prevent duplicates in libs/..."
	@rm -f libBACKEND.so libBACKEND.dylib
EOF
fi

# Since we are guaranteed to be in the active build directory of R CMD build,
# we delete the Git leftovers and Makefiles using the shell, regardless of the platform:

echo " [configure] Clean Git residue and CMake artifacts..."
rm -rf src/backend/lib/CLErrorLookup/.git
rm -rf src/backend/lib/OpenCL-CLHPP/.git
rm -rf src/backend/lib/OpenCL-Headers/.git
rm -rf src/backend/lib/OpenCL-Wrapper/.git

# Delete the temporary GNU Makefiles that the check system complains about
#rm -rf src/backend/build/ << that's too much!
rm -f  src/backend/build/Makefile
rm -f  src/backend/lib/OpenCL-CLHPP/external/CMock/vendor/unity/extras/fixture/test/Makefile
rm -f  src/backend/lib/OpenCL-CLHPP/external/CMock/vendor/unity/extras/memory/test/Makefile
rm -f  src/backend/lib/OpenCL-CLHPP/external/CMock/vendor/unity/test/Makefile


echo " [configure] Fix missing newlines in headers and C files..."

for FILE in \
    "src/backend/lib/CLErrorLookup/CLErrorLookup/include/cl_error_lookup.hpp" \
    "src/backend/lib/OpenCL-CLHPP/external/CMock/vendor/unity/examples/example_2/test/test_runners/TestProductionCode2_Runner.c" \
    "src/backend/lib/OpenCL-CLHPP/external/CMock/vendor/unity/examples/example_2/test/test_runners/TestProductionCode_Runner.c" \
    "src/backend/lib/OpenCL-CLHPP/tests/test_versions.cpp" \
    "inst/include/cl_error_lookup.hpp"    ; do
    if [ -f "$FILE" ]; then
        # Check if the last character is a newline
        if [ "$(tail -c1 "$FILE" | wc -l)" -eq 0 ]; then
            echo "   -> append newline: $FILE"
            echo "" >> "$FILE"
        fi
    fi
done


echo " [OpenCLeaR Linux/macOS build] Fixed all third-party files treewide for R CMD check"

exit 0
