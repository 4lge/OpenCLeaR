#!/bin/sh
set -e

# Compile the Backend library first:
echo "** COMPILING THE OPENCL BACKEND CODE NOW! **"

BUILD_DIR="src/backend/build"
INSTALL_DIR="src"

# Detect OS and set appropriate extension and rpath flags.
UNAME=$(uname)
if [ "${UNAME}" = "Darwin" ]; then
    # macOS settings
    SHLIB_EXT="dylib"
else
    # Linux settings
    SHLIB_EXT="so"
fi

mkdir -p "$BUILD_DIR"
mkdir -p "$INSTALL_DIR"

cd "$BUILD_DIR" || {
	echo "Build dir was not made! Check if you have permissions..."
	exit 1
}

cmake .. -DCMAKE_BUILD_TYPE=Release || {
	echo "CMake configuration failed..."
	exit 1
}

cmake --build . || {
	echo "Build failed..."
	exit 1
}

# Copy the binary in src/
DLL_NAME="libBACKEND."${SHLIB_EXT}
if [ -f "$DLL_NAME" ]; then
	cp "$DLL_NAME" ../../$DLL_NAME
elif [ -f "Release/$DLL_NAME" ]; then
	cp "Release/$DLL_NAME" ../../$DLL_NAME
else
	echo "Could not find built $DLL_NAME"
	exit 1
fi

echo "** SUCCESSFULLY BUILT OPENCL BACKEND CODE! **"

# Zurück ins Hauptverzeichnis des Pakets wechseln
cd ../../..

# =========================================================================
# 🎯 AUTOMATISCHER TRANSFER IN DIE RECHTE ORDNEREBENE
# =========================================================================
# Wir kopieren die gebauten Bibliotheken JETZT schon direkt in den src-Ordner,
# damit der R-Compiler sie beim Linken sofort lokal vorfindet.
mkdir -p src/

if [ -f "libBACKEND.so" ]; then
    cp libBACKEND.so src/
fi
if [ -f "libBACKEND.dylib" ]; then
    cp libBACKEND.dylib src/
fi

# =========================================================================
# 🐧🍏 Plattformspezifische src/Makevars direkt und verlustfrei generieren
# =========================================================================
UNAME=$(uname)

if [ "${UNAME}" = "Darwin" ]; then
    # 🍏 macOS Version: R_PACKAGE_DIR-Kopiertarget nutzt den lokalen src/-Pfad
    cat << 'EOF' > src/Makevars
PKG_CPPFLAGS = -I./backend/include -I./backend/build/local_install/include 
PKG_LIBS = -Wl,-rpath,@loader_path/ -Wl,-rpath,@loader_path/../ -Wl,-rpath,@loader_path/../src/ -L. -lBACKEND

.PHONY: all prebuild

all: $(SHLIB)
	@echo "⏳ [OpenCLeaR] Kopiere Binaries in das temporäre macOS-Zielverzeichnis..."
	@mkdir -p $(R_PACKAGE_DIR)/src/ $(R_PACKAGE_DIR)/libs/
	@if [ -f libBACKEND.dylib ]; then cp libBACKEND.dylib $(R_PACKAGE_DIR)/src/ && cp libBACKEND.dylib $(R_PACKAGE_DIR)/libs/; fi
	@if [ -f backend/build/local_install/lib/libOpenCL.dylib ]; then cp backend/build/local_install/lib/libOpenCL.dylib $(R_PACKAGE_DIR)/src/ && cp backend/build/local_install/lib/libOpenCL.dylib $(R_PACKAGE_DIR)/libs/; fi
EOF

else
    # 🐧 Linux Version
    cat << 'EOF' > src/Makevars
PKG_CPPFLAGS = -I./backend/include -I./backend/build/local_install/include 
PKG_LIBS = -Wl,-rpath,'$$ORIGIN:.:./src' -Wl,--enable-new-dtags -L. -lBACKEND

.PHONY: all prebuild

all: $(SHLIB)
	@echo "⏳ [OpenCLeaR] Kopiere Binaries in das temporäre Linux-Zielverzeichnis..."
	@mkdir -p $(R_PACKAGE_DIR)/src/ $(R_PACKAGE_DIR)/libs/
	@if [ -f libBACKEND.so ]; then cp libBACKEND.so $(R_PACKAGE_DIR)/src/ && cp libBACKEND.so $(R_PACKAGE_DIR)/libs/; fi
	@if [ -f backend/build/local_install/lib/libOpenCL.so ]; then cp backend/build/local_install/lib/libOpenCL.so $(R_PACKAGE_DIR)/src/ && cp backend/build/local_install/lib/libOpenCL.so $(R_PACKAGE_DIR)/libs/; fi
EOF
fi

exit 0
